# ========== RENDER DEPLOYMENT VARIABLES ==========

# ML API Service (Render)
ML_API_PORT=8000
ML_API_URL=https://navi-tax-ml-api.onrender.com
FLASK_ENV=production

# Backend Service (Render)
PORT=3001
NODE_ENV=production
BACKEND_URL=https://navi-tax-backend.onrender.com

# ========== FRONTEND VARIABLES (Vercel) ==========
VITE_BACKEND_URL=https://navi-tax-backend.onrender.com
VITE_ML_API_URL=https://navi-tax-ml-api.onrender.com

# ========== SUPABASE VARIABLES ==========
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-key-here
SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Database
SUPABASE_DB_HOST=db.your-project.supabase.co
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-db-password

# ========== FRONTEND URLS FOR VITE ==========
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here