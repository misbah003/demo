# ============================================================================
# BACKEND API CONFIGURATION - PRODUCTION DEPLOYMENT
# ============================================================================
# 
# Copy this file to .env.production and fill in your actual values
# NEVER commit real secrets to GitHub - use platform dashboards instead
#

# ============================================================================
# EMAIL CONFIGURATION (Gmail SMTP)
# ============================================================================
# Gmail address for sending OTPs and notifications

GMAIL_USER=your-email@gmail.com

# Gmail App Password (NOT your regular password)
# IMPORTANT: This is different from your Gmail password!
# Generate at: https://myaccount.google.com/apppasswords
# Steps:
#   1. Enable 2-Factor Authentication on your Gmail account
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Select Device: "Other (custom name)"
#   4. Enter: "Tax Intelligence Backend"
#   5. Generate and copy the 16-character password

GMAIL_APP_PASSWORD=your-16-character-app-password

# ============================================================================
# SUPABASE DATABASE CONFIGURATION
# ============================================================================
# Get these from: https://app.supabase.com → Settings → API

# Your Supabase project URL (format: https://xxx.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Service Role Key (KEEP THIS SECRET - only use in backend!)
# This allows full admin access to your database
# Get from: Settings → API → Service Role Key
# ⚠️ NEVER expose this to the frontend!

SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# ML API CONFIGURATION
# ============================================================================
# URL of your deployed ML API service

# For local development:
# ML_API_URL=http://localhost:8000

# For production (Render):
# ML_API_URL=https://navi-tax-ml-api.onrender.com

ML_API_URL=https://navi-tax-ml-api.onrender.com

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Port the backend runs on (Render will override this)
PORT=3001

# Environment (production, development, staging)
NODE_ENV=production

# Frontend URL for CORS (update with your Vercel URL)
# Format: https://your-project.vercel.app
FRONTEND_URL=https://your-project.vercel.app

# ============================================================================
# LOGGING & DEBUGGING
# ============================================================================

# Enable detailed logging (development only)
DEBUG=false

# ============================================================================
# EXAMPLES (Uncomment to see format)
# ============================================================================
#
# GMAIL_USER=taxintelligence@gmail.com
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
# SUPABASE_URL=https://xyz123abc.supabase.co
# SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# ML_API_URL=https://navi-tax-ml-api.onrender.com
# PORT=3001
# NODE_ENV=production
# FRONTEND_URL=https://navi-tax-abc123.vercel.app
#
# ============================================================================
